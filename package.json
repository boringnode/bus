{
  "name": "@boringnode/bus",
  "description": "A simple and lean driver-based service bus implementation",
  "version": "0.10.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/boringnode/bus"
  },
  "engines": {
    "node": ">=20.6"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./transports/*": "./build/src/transports/*.js",
    "./test_helpers": "./build/src/test_helpers.js",
    "./types/*": "./build/src/types/*.js"
  },
  "scripts": {
    "build": "yarn clean && tsup-node",
    "clean": "del-cli build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepublishOnly": "yarn build",
    "release": "release-it",
    "update:toc": "yarn dlx doctoc README.md",
    "test": "c8 yarn quick:test",
    "quick:test": "yarn node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@swc/core": "^1.16.21",
    "@testcontainers/hivemq": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^20.19.43",
    "@types/object-hash": "^3.0.6",
    "c8": "^12.0.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "ioredis": "^6.0.0",
    "mqtt": "^5.16.1",
    "prettier": "^3.9.10",
    "release-it": "^21.1.2",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@poppinss/utils": "^7.1.2",
    "object-hash": "^3.0.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0 || ^6.0.0",
    "mqtt": "^5.16.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "mqtt": {
      "optional": true
    }
  },
  "author": "Romain Lanz <romain.lanz@pm.me>",
  "contributors": [
    "Julien Ripouteau <julien@ripouteau.com>"
  ],
  "license": "MIT",
  "keywords": [
    "bus",
    "transport",
    "service bus"
  ],
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
